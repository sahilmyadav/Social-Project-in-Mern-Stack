# ==============================================
# Social App - Development Environment Variables
# ==============================================
# Copy this file to .env.development for local dev
# Usage: docker compose -f docker-compose.dev.yml up --build
# ==============================================

# ===================
# Frontend Configuration
# ===================
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# ===================
# Backend Configuration
# ===================
NODE_ENV=development
PORT=5000

# MongoDB (use local or Atlas)
MONGODB_URI=mongodb://localhost:27017/social_app

# Redis
REDIS_URL=redis://redis:6379

# JWT Secrets
JWT_SECRET=dev-secret-key-not-for-production
JWT_REFRESH_SECRET=dev-refresh-secret-not-for-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email (use Mailtrap for dev)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Dev <dev@localhost>

# CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
