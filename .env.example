# ==============================================
# Social App - Docker Environment Configuration
# Domain: clikkme.in
# ==============================================
# Copy this file to .env and fill in the values
# Usage: cp .env.example .env

# ===============
# Frontend Config
# ===============
NEXT_PUBLIC_API_URL=https://clikkme.in/api/v1
NEXT_PUBLIC_API_BASE_URL=https://clikkme.in/api/v1
NEXT_PUBLIC_SOCKET_URL=https://clikkme.in
NEXT_PUBLIC_ENCRYPTION_KEY=change-this-to-a-secure-key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_name
NEXT_PUBLIC_ENV=production

# ===============
# Backend Config
# ===============
NODE_ENV=production
PORT=5000

# Database
DB_NAME=social_media_app
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/social_media_app

# CORS & Frontend
CORS_ORIGIN=https://clikkme.in,https://www.clikkme.in
FRONTEND_URL=https://clikkme.in

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET_KEY=your_secret_key

# SMTP
SMTP_FROM=your-email@gmail.com
SMTP_USER=your-email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PASS=your-app-password
SMTP_PORT=587

# JWT Tokens
ACCESS_TOKEN_SECRET=change-this-to-secure-secret
REFRESH_TOKEN_SECRET=change-this-to-secure-secret
RESET_SECRET=change-this-to-secure-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# Encryption
ENCRYPTION_KEY=change-this-to-a-secure-key

# Redis (Docker internal network)
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Spotify (optional)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret
