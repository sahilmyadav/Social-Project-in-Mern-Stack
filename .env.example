# ==============================================
# Social App - Docker Environment Configuration
# Domain: clikkme.in
# ==============================================
# Copy this file to .env and fill in the values
# Usage: cp .env.example .env

# ===============
# Frontend Config
# ===============
NEXT_PUBLIC_API_URL=https://clikkme.in/api/v1
NEXT_PUBLIC_API_BASE_URL=https://clikkme.in/api/v1
NEXT_PUBLIC_SOCKET_URL=https://clikkme.in
NEXT_PUBLIC_ENCRYPTION_KEY=change-this-to-a-secure-key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_name
NEXT_PUBLIC_ENV=production

# ===============
# Backend Config
# ===============
NODE_ENV=production
PORT=5000

# Database
DB_NAME=social_media_app
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/social_media_app
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# CORS & Frontend
CORS_ORIGIN=https://clikkme.in,https://www.clikkme.in
FRONTEND_URL=https://clikkme.in

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_SECRET_KEY=your_secret_key

# SMTP
SMTP_FROM=your-email@gmail.com
SMTP_USER=your-email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PASS=your-app-password
SMTP_PORT=587

# JWT Tokens
ACCESS_TOKEN_SECRET=change-this-to-secure-secret
REFRESH_TOKEN_SECRET=change-this-to-secure-secret
RESET_SECRET=change-this-to-secure-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# Encryption
ENCRYPTION_KEY=change-this-to-a-secure-key

# Redis (Docker internal network)
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Spotify (optional)
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# ===============
# Firebase FCM (Push Notifications — Calls, Messages, Alerts)
# ===============
# Get this from: Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the entire JSON as a single line:
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\nxxx\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxx%40your-project-id.iam.gserviceaccount.com"}

# TURN Server (WebRTC Calls)
TURN_SERVER=turn.clikkme.in
TURN_PORT=3478
TURNS_PORT=5349
TURN_SECRET=clikkme_turn_secret
TURN_CREDENTIAL_TTL=3600

# Cluster mode (enable Redis adapter for Socket.IO in production)
ENABLE_CLUSTER=false
