# Production Environment Variables
# ================================
# This file contains environment variables for docker-compose.yml
# Copy this file to .env and fill in your values

# ===================
# Domain Configuration
# ===================
DOMAIN=yourdomain.com

# ===================
# MongoDB
# ===================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/social_app?retryWrites=true&w=majority

# ===================
# Frontend Build Args
# ===================
NEXT_PUBLIC_API_URL=https://yourdomain.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://yourdomain.com

# ===================
# Optional: External Services
# ===================
# These can also be set in backend/.env.production

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase
FIREBASE_PROJECT_ID=
